{
  "name": "routine-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/build-extension.mjs && electron-vite build",
    "start": "node scripts/run.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:recording": "node scripts/recording-test.mjs",
    "demo": "node packages/demo-site/server.ts",
    "demo:reset": "node packages/demo-site/server.ts --reset"
  },
  "dependencies": {
    "@xyflow/react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-vite": "latest",
    "playwright": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
