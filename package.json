{
  "name": "routine-studio",
  "version": "0.7.0-rc.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/build-extension.mjs && electron-vite build",
    "package:win": "node scripts/package-win.mjs",
    "package:installer": "node scripts/build-installer.mjs",
    "start": "node scripts/run.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:recording": "node scripts/recording-test.mjs",
    "test:configuration": "node scripts/configuration-test.mjs",
    "test:execution": "node scripts/execution-test.mjs",
    "test:csv": "node scripts/batch-test.mjs --prepare-only",
    "test:batch": "node scripts/batch-test.mjs",
    "test:assistance": "node scripts/assistance-test-runner.mjs",
    "test:openai-assistance": "node scripts/openai-assistance-test.mjs",
    "test:prepare": "node scripts/prepare-workflow-test.mjs",
    "test:packaged": "node scripts/packaged-test.mjs",
    "demo": "node packages/demo-site/server.ts",
    "demo:reset": "node packages/demo-site/server.ts --reset"
  },
  "dependencies": {
    "@xyflow/react": "latest",
    "css-tree": "^3.2.1",
    "csv-parse": "7.0.3",
    "openai": "^6.9.1",
    "playwright": "^1.64.1",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@electron/packager": "^20.1.1",
    "@types/chrome": "^0.3.7",
    "@types/css-tree": "^3.2.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "electron-builder": "^26.0.12",
    "electron-vite": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
